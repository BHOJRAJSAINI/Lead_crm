# ---- Supabase (Vercel dashboard only — never commit real values) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server only, RLS bypass
SUPABASE_ANON_KEY=<anon-key>

# ---- Google Sheets sync (service account, Sheets API v4) ----
# The whole service-account JSON, base64-encoded:
GOOGLE_SERVICE_ACCOUNT_JSON=<base64-of-service-account-json>
GOOGLE_SHEET_ID=1gma1CsjqFUcPmn35uV5S0LHVK70N5Bco4vGNWk1Al_g
# Optional: Apps Script onChange webhook secret (HMAC-SHA256 hex of raw body)
SHEET_WEBHOOK_SECRET=<random-hex>

# ---- App ----
CRON_SECRET=<random-hex>          # Vercel Cron sends: Authorization: Bearer $CRON_SECRET
SESSION_SECRET=<random-hex>       # token hashing pepper
APP_TIMEZONE=Asia/Kolkata
QUOTATIONS_BUCKET=quotations      # private Supabase Storage bucket
LOGO_FILE_ID=1dewoxg1ygw36v83RAegBcp1oGjhcRJZa
QUOTATION_HEADER_URL=<public URL of quotation header image, or Supabase Storage path>
